# Ouroboros v2 — variáveis do Supabase.
#
# Copie este arquivo para `.env.local` e preencha. As duas são `NEXT_PUBLIC_`
# porque o app fala com o Supabase direto do browser: quem protege os dados é a
# RLS, não o segredo da chave. Nunca coloque a `service_role key` aqui.
#
# Para o ambiente local (`npx supabase start`), os valores saem de
# `npx supabase status`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
