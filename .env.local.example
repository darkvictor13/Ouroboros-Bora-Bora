# Ouroboros v2 — variáveis do Supabase.
#
# Copie este arquivo para `.env.local` e preencha. As duas são `NEXT_PUBLIC_`
# porque o app fala com o Supabase direto do browser: quem protege os dados é a
# RLS, não o segredo da chave. Nunca coloque a `service_role key` aqui.
#
# Para o ambiente local (`npx supabase start`), os valores saem de
# `npx supabase status`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Sentry (opcional) ────────────────────────────────────────────────────────
# Vazio = desligado, e é assim que fica em desenvolvimento: nada é enviado e a
# quota de 5.000 erros/mês do plano Free (que é da organização inteira, staging
# e produção somados) não é gasta com erro de código em andamento.
#
# O DSN é público como a anon key — ele só permite ESCREVER evento, não ler
# nada. O `SENTRY_AUTH_TOKEN`, que sobe os sourcemaps, é segredo de verdade e
# vive só nos secrets do GitHub; não coloque aqui.
#
# Ver PLANO-SENTRY.md.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
